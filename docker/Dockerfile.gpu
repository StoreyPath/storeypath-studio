# StoreyPath Studio with vision, for a machine with an NVIDIA GPU: Studio, the vision
# model (Gemma 4 31B) and the language model, all in one image. No network needed at
# run time.
#
#   docker/fetch-models.sh && docker/fetch-vision.sh           # once, before building
#   docker build -f docker/Dockerfile.gpu -t storeypath/studio:gpu .
#   docker save storeypath/studio:gpu | gzip -1 > storeypath-studio-gpu.tar.gz
#
# On the GPU machine (Docker and the NVIDIA Container Toolkit installed):
#
#   docker load -i storeypath-studio-gpu.tar.gz
#   docker run -d --name storeypath --gpus all -p 8080:8080 -v storeypath:/data storeypath/studio:gpu
#
# (to reach it by a host name, add -e STOREYPATH_ALLOWED_HOSTS=<that name>; addresses
# and localhost always work, and the names go on Studio's certificate)
# then, once `docker logs storeypath` says Studio is serving (loading the vision model
# takes a minute or two), open the setup link it printed the first time, to make the
# first admin (or set -e STOREYPATH_ADMIN_PASSWORD=…), and then https://localhost:8080.
# Studio serves HTTPS with a certificate it makes in /data/tls: browsers warn once (the
# log prints its fingerprint). Arguments after the image go to `storeypath serve`:
# --cert /tls/cert.pem --key /tls/key.pem (your own, mounted), or --http
# --secure-cookies --trusted-proxy <its address> behind a proxy that speaks HTTPS (it
# must set X-Real-IP). One GPU with 32 GB free is
# enough: the vision model, two rooms looked at at once, and the language model, all on
# the GPU; pick one with --gpus '"device=1"'. NVIDIA driver 525 or newer (CUDA 12).
# docker/start-gpu.sh starts the vision model, then Studio; its settings:
# STOREYPATH_VISION_PARALLEL (rooms looked at at once, default 2; more needs more GPU
# memory), STOREYPATH_VISION=off (no vision), STOREYPATH_VISION_URL (a vision model
# served elsewhere instead). For the command-line tool: --entrypoint storeypath.
#
# Inside: StoreyPath Studio (Apache-2.0), with pyca/cryptography (Apache-2.0 or BSD) to
# make its certificate; LibreDWG's dwg2dxf for reading DWG
# (GPL-3.0-or-later, a separate program; its exact source is in
# /usr/share/storeypath/source); llama.cpp's llama-server built for CUDA (MIT) with
# NVIDIA's CUDA runtime and cuBLAS (CUDA Toolkit EULA, redistributable); Gemma 4 31B, 4-bit
# (Apache-2.0); a Qwen3.5 model (Apache-2.0) for reading the text in drawings;
# three.js (MIT), MapLibre GL JS (BSD-3-Clause) and JSZip (MIT) for the viewer;
# Node.js (MIT), the program alone, to build the floors' 3D ahead of time when
# exporting. Licences: /usr/share/storeypath/licenses. SymPoint-V2 is never in this image.

ARG CUDA=12.8.2
ARG UBUNTU=24.04

# ---- llama.cpp for CUDA ------------------------------------------------------------------
FROM nvidia/cuda:${CUDA}-devel-ubuntu${UBUNTU} AS llama
ARG LLAMA_CPP_VERSION=b11429
# Machine code for each GPU generation, so nothing is compiled when the image starts
# (and any CUDA 12 driver runs it): A100/A30 (80), RTX 30xx/A10/A40 (86), L4/L40/RTX
# 40xx (89), H100/H200 (90), Blackwell (120).
ARG CUDA_ARCHITECTURES="80-real;86-real;89-real;90-real;120-real"
ARG JOBS=""
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${LLAMA_CPP_VERSION}" https://github.com/ggml-org/llama.cpp /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
        -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" -DGGML_CUDA_NCCL=OFF \
        -DGGML_CUDA_CCCL_VERSION=v3.4.3 \
        -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON \
        -DCMAKE_INSTALL_RPATH='$ORIGIN' -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON \
    && cmake --build /build --target llama-server -j"${JOBS:-$(nproc)}"
# The server, its libraries and the CUDA runtime it links against, side by side.
RUN mkdir -p /opt/llama \
    && cp /build/bin/llama-server /opt/llama/ \
    && cp -P /build/bin/*.so* /opt/llama/ \
    && cp -P /usr/local/cuda/lib64/libcudart.so.12* /usr/local/cuda/lib64/libcublas.so.12* \
             /usr/local/cuda/lib64/libcublasLt.so.12* /opt/llama/ \
    && cp /src/LICENSE /opt/llama/LICENSE \
    && printf '%s\n' 'NVIDIA CUDA runtime and cuBLAS (libcudart, libcublas, libcublasLt), redistributed' \
         'under the CUDA Toolkit End User License Agreement: https://docs.nvidia.com/cuda/eula/' \
         > /opt/llama/CUDA-NOTICE.txt

# ---- LibreDWG: reading DWG ---------------------------------------------------------
FROM ubuntu:${UBUNTU} AS libredwg
ARG LIBREDWG_VERSION=0.14
# The release tarball, as GNU publishes it (also attached to the GitHub release, for
# networks that cannot reach ftp.gnu.org).
ARG LIBREDWG_SHA256=cb6ee0b078c6d9e0f09d66f1feac33ba6342df88ae544e9f9335fab475218351
ARG JOBS=""
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config python3 curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN f="libredwg-${LIBREDWG_VERSION}.tar.gz" \
    && { curl -fsSL --connect-timeout 20 -o "$f" "https://ftp.gnu.org/gnu/libredwg/$f" \
         || curl -fsSL --connect-timeout 20 -o "$f" "https://github.com/LibreDWG/libredwg/releases/download/${LIBREDWG_VERSION}/$f"; } \
    && echo "${LIBREDWG_SHA256}  $f" | sha256sum -c - \
    && tar xf "$f"
RUN cd "libredwg-${LIBREDWG_VERSION}" \
    && ./configure --prefix=/opt/libredwg --disable-bindings --disable-static --disable-docs \
    && make -j"${JOBS:-$(nproc)}" \
    && make install \
    && mkdir -p /opt/source /opt/licenses \
    && cp "/src/libredwg-${LIBREDWG_VERSION}.tar.gz" /opt/source/ \
    && cp COPYING /opt/licenses/LICENSE-libredwg.txt

# ---- the 2D plan engine (viewer/svg), compiled from its TypeScript; and Node.js, ---------
# whose program alone goes into the image: Studio runs the viewer's baker with it
# (viewer/world/bake.mjs, in Studio's package, with three.js and JSZip beside it)
FROM node:22-slim AS plan
COPY viewer/svg /build/svg
RUN cd /build/svg && npm ci --no-audit --no-fund && npm run build

# ---- StoreyPath Studio ---------------------------------------------------------------
FROM ubuntu:${UBUNTU} AS studio
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /usr/local/bin/uv
RUN uv venv --python /usr/bin/python3 /opt/storeypath
COPY studio /build/studio
COPY spec /build/spec
COPY viewer /build/viewer
COPY --from=plan /build/svg/dist /build/viewer/svg/dist
RUN cd /build/studio && uv build --wheel -o /build/dist \
    && VIRTUAL_ENV=/opt/storeypath uv pip install --no-cache "$(ls /build/dist/*.whl)[vision]"

# ---- the image -------------------------------------------------------------------------
FROM ubuntu:${UBUNTU}
ARG MODEL=Qwen3.5-4B-Q4_K_M.gguf
RUN apt-get update && apt-get install -y --no-install-recommends python3 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/storeypath storeypath \
    && mkdir -p /data && chown storeypath /data
COPY --from=llama /opt/llama /opt/llama
COPY --from=libredwg /opt/libredwg /opt/libredwg
COPY --from=libredwg /opt/source /usr/share/storeypath/source
COPY --from=libredwg /opt/licenses /usr/share/storeypath/licenses
COPY --from=studio /opt/storeypath /opt/storeypath
COPY --from=plan /usr/local/bin/node /opt/node/bin/node
COPY --from=plan /usr/local/LICENSE /usr/share/storeypath/licenses/LICENSE-node.js.txt
COPY docker/models/${MODEL} /opt/storeypath/models/${MODEL}
COPY docker/models/vision/gemma-4-31B-it-Q4_K_M.gguf docker/models/vision/mmproj-F16.gguf /opt/storeypath/vision/
COPY docker/start-gpu.sh /usr/local/bin/storeypath-gpu
COPY viewer/vendor/LICENSE-maplibre-gl.txt viewer/vendor/LICENSE-jszip.markdown /usr/share/storeypath/licenses/
COPY viewer/vendor/three/LICENSE /usr/share/storeypath/licenses/LICENSE-three.js.txt
RUN cp /opt/llama/LICENSE /usr/share/storeypath/licenses/LICENSE-llama.cpp.txt \
    && cp /opt/llama/CUDA-NOTICE.txt /usr/share/storeypath/licenses/ \
    && cp /opt/storeypath/lib/python3*/site-packages/storeypath-*.dist-info/licenses/LICENSE \
          /usr/share/storeypath/licenses/LICENSE-storeypath.txt \
    && printf 'Qwen3.5 model weights: Apache License 2.0, Copyright Alibaba Cloud (Qwen team).\nhttps://huggingface.co/Qwen\n' \
          > /usr/share/storeypath/licenses/LICENSE-model.txt \
    && printf 'Gemma 4 model weights: Apache License 2.0, Google (https://ai.google.dev/gemma/docs/gemma_4_license).\nGGUF conversion: https://huggingface.co/unsloth/gemma-4-31B-it-GGUF\n' \
          > /usr/share/storeypath/licenses/LICENSE-vision-model.txt

ENV PATH="/opt/storeypath/bin:/opt/llama:/opt/libredwg/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/llama:/opt/libredwg/lib" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    STOREYPATH_MODELS=/opt/storeypath/models \
    STOREYPATH_GPU_LAYERS=99 \
    STOREYPATH_VISION_GGUF=/opt/storeypath/vision/gemma-4-31B-it-Q4_K_M.gguf \
    STOREYPATH_VISION_MMPROJ=/opt/storeypath/vision/mmproj-F16.gguf \
    STOREYPATH_VISION_PARALLEL=2 \
    STOREYPATH_NODE=/opt/node/bin/node \
    PYTHONUNBUFFERED=1

USER storeypath
WORKDIR /data
VOLUME /data
EXPOSE 8080
# a check from inside, of Studio's own page (no login needed): over HTTPS, its own
# certificate not checked; over plain HTTP when it was started with --http
HEALTHCHECK --interval=30s --timeout=5s --start-period=15m \
    CMD python3 -c "import ssl, urllib.request as u; u.urlopen('https://127.0.0.1:8080/login.html', timeout=4, context=ssl._create_unverified_context())" \
     || python3 -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/login.html', timeout=4)"
LABEL org.opencontainers.image.title="StoreyPath Studio (GPU, with vision)" \
      org.opencontainers.image.description="Turn DWG/DXF floor plans into portable indoor maps with stable IDs; reads the plans with a vision model on the GPU; runs offline" \
      org.opencontainers.image.source="https://github.com/StoreyPath/storeypath" \
      org.opencontainers.image.licenses="Apache-2.0 AND GPL-3.0-or-later AND MIT AND BSD-3-Clause"
ENTRYPOINT ["storeypath-gpu"]

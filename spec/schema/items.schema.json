{
  "$defs": {
    "Feature_ItemProps_": {
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "MultiPolygon": "#/$defs/MultiPolygonGeometry",
                  "Point": "#/$defs/PointGeometry",
                  "Polygon": "#/$defs/PolygonGeometry"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PointGeometry"
                },
                {
                  "$ref": "#/$defs/PolygonGeometry"
                },
                {
                  "$ref": "#/$defs/MultiPolygonGeometry"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/ItemProps"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "Feature[ItemProps]",
      "type": "object"
    },
    "ItemProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "item",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "description": "the item's type: a code of catalogue.json (DESK-MANAGER, COPIER, \u2026)",
          "title": "Type",
          "type": "string"
        },
        "category": {
          "enum": [
            "furniture",
            "equipment",
            "appliance"
          ],
          "title": "Category",
          "type": "string"
        },
        "name": {
          "description": "its type's English name, for readers that do not read the catalogue",
          "title": "Name",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the space it stands in (null: in none of them)",
          "title": "Space Id"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the zone it stands in, when its space is divided",
          "title": "Zone Id"
        },
        "display_point": {
          "description": "its middle",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Display Point",
          "type": "array"
        },
        "heading": {
          "description": "the way its front faces: degrees clockwise from north",
          "title": "Heading",
          "type": "number"
        },
        "width_m": {
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "title": "Depth M",
          "type": "number"
        },
        "height_m": {
          "title": "Height M",
          "type": "number"
        },
        "mount": {
          "enum": [
            "floor",
            "wall",
            "ceiling"
          ],
          "title": "Mount",
          "type": "string"
        },
        "elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how high above the floor its bottom is (null for one on the ceiling: just under it)",
          "title": "Elevation M"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "its details entered in StoreyPath, by the catalogue's field keys (the others belong to the system that manages the asset)",
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "type",
        "category",
        "name",
        "floor_id",
        "building_id",
        "display_point",
        "heading",
        "width_m",
        "depth_m",
        "height_m",
        "mount"
      ],
      "title": "ItemProps",
      "type": "object"
    },
    "MultiPolygonGeometry": {
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygonGeometry",
      "type": "object"
    },
    "PointGeometry": {
      "properties": {
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    },
    "PolygonGeometry": {
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/Feature_ItemProps_"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "FeatureCollection[ItemProps]",
  "type": "object"
}
{
  "$defs": {
    "ItemFeature": {
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "description": "its asset ID (format 0.8): ten random symbols of Crockford's base32 and a check symbol, 4-4-3 (7K2Q-XM9F-4DP), of no project or place: carried anywhere, it keeps it",
          "title": "Id",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/PolygonGeometry",
          "description": "its footprint, on the map"
        },
        "properties": {
          "$ref": "#/$defs/ItemProps"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "ItemFeature",
      "type": "object"
    },
    "ItemLocal": {
      "description": "Where an item stands in its building's own frame: what it is placed by. The\nbuilding's position on the map never changes it.",
      "properties": {
        "x_m": {
          "description": "metres from the origin of the building's drawings, along their x",
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "description": "metres from the origin of the building's drawings, along their y",
          "title": "Y M",
          "type": "number"
        },
        "rotation_deg": {
          "description": "the way its front faces, in degrees counter-clockwise: 0 the drawings' -y, 90 their +x",
          "title": "Rotation Deg",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "rotation_deg"
      ],
      "title": "ItemLocal",
      "type": "object"
    },
    "ItemProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "item",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "description": "the item's type: a code of catalogue.json (DESK-MANAGER, COPIER, \u2026)",
          "title": "Type",
          "type": "string"
        },
        "category": {
          "enum": [
            "furniture",
            "equipment",
            "appliance"
          ],
          "title": "Category",
          "type": "string"
        },
        "name": {
          "description": "its type's English name, for readers that do not read the catalogue",
          "title": "Name",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the space it stands in (null: in none of them)",
          "title": "Space Id"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the zone it stands in, when its space is divided",
          "title": "Zone Id"
        },
        "local": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemLocal"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where it stands in its building (format 0.7): its middle and turn in the building's own frame, unchanged when the building moves on the map; the footprint, display_point and heading follow from it and the building's placement"
        },
        "display_point": {
          "description": "its middle, on the map",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Display Point",
          "type": "array"
        },
        "heading": {
          "description": "the way its front faces: degrees clockwise from north",
          "title": "Heading",
          "type": "number"
        },
        "width_m": {
          "title": "Width M",
          "type": "number"
        },
        "depth_m": {
          "title": "Depth M",
          "type": "number"
        },
        "height_m": {
          "title": "Height M",
          "type": "number"
        },
        "mount": {
          "enum": [
            "floor",
            "wall",
            "ceiling"
          ],
          "title": "Mount",
          "type": "string"
        },
        "elevation_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how high above the floor its bottom is (null for one on the ceiling: just under it)",
          "title": "Elevation M"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "its details entered in StoreyPath, by the catalogue's field keys (the others belong to the system that manages the asset)",
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "type",
        "category",
        "name",
        "floor_id",
        "building_id",
        "display_point",
        "heading",
        "width_m",
        "depth_m",
        "height_m",
        "mount"
      ],
      "title": "ItemProps",
      "type": "object"
    },
    "PolygonGeometry": {
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/ItemFeature"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "FeatureCollection[ItemFeature]",
  "type": "object"
}
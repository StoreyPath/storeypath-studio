{
  "$defs": {
    "LocationFeature": {
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "geometry": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "MultiPolygon": "#/$defs/MultiPolygonGeometry",
                  "Polygon": "#/$defs/PolygonGeometry"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/PolygonGeometry"
                },
                {
                  "$ref": "#/$defs/MultiPolygonGeometry"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "the convex hull of its buildings (null: none has a footprint)",
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/LocationProps"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "LocationFeature",
      "type": "object"
    },
    "LocationProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "location",
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "display_point": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Point"
        }
      },
      "required": [
        "kind",
        "code",
        "name",
        "project_id"
      ],
      "title": "LocationProps",
      "type": "object"
    },
    "MultiPolygonGeometry": {
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygonGeometry",
      "type": "object"
    },
    "PolygonGeometry": {
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/LocationFeature"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "FeatureCollection[LocationFeature]",
  "type": "object"
}
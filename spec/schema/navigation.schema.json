{
  "$defs": {
    "NavEdge": {
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "kind": {
          "enum": [
            "walk",
            "door",
            "lift",
            "stairs",
            "escalator",
            "ramp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "length_m": {
          "minimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "seconds": {
          "description": "walking at speed_m_s; lifts and stairs as FORMAT.md says",
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "cost": {
          "description": "what routing takes the fewest of: seconds, and more for a way into a room not for passing through",
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "accessible": {
          "description": "false for stairs and escalators",
          "title": "Accessible",
          "type": "boolean"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space Id"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        },
        "path": {
          "description": "its line, from `from` to `to`, in the building's frame",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "length_m",
        "seconds",
        "cost",
        "accessible",
        "path"
      ],
      "title": "NavEdge",
      "type": "object"
    },
    "NavFloor": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "building_id": {
          "title": "Building Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "elevation": {
          "title": "Elevation",
          "type": "number"
        }
      },
      "required": [
        "id",
        "building_id",
        "name",
        "ordinal",
        "elevation"
      ],
      "title": "NavFloor",
      "type": "object"
    },
    "NavLocal": {
      "properties": {
        "x_m": {
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m"
      ],
      "title": "NavLocal",
      "type": "object"
    },
    "NavNode": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "stable: what it is (door:<opening>, room:<space or zone>, kiosk:<item>, lift:<code>@<floor>, \u2026)",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "door",
            "entrance",
            "approach",
            "room",
            "kiosk",
            "lift",
            "stairs",
            "escalator",
            "ramp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the space it is in (null for a door: see spaces)",
          "title": "Space Id"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the zone it is in, in a space divided into zones",
          "title": "Zone Id"
        },
        "local": {
          "$ref": "#/$defs/NavLocal",
          "description": "where it is in its building's own frame, metres"
        },
        "lonlat": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Lonlat",
          "type": "array"
        },
        "opening_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a door's, entrance's or approach's opening (null for the way into a lift or stairs no opening is drawn for)",
          "title": "Opening Id"
        },
        "spaces": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a door's: the spaces it joins (one, for an entrance)",
          "title": "Spaces"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a kiosk's item",
          "title": "Item Id"
        },
        "stack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a lift's, stairs', escalator's or ramp's stack",
          "title": "Stack"
        }
      },
      "required": [
        "id",
        "kind",
        "floor_id",
        "local",
        "lonlat"
      ],
      "title": "NavNode",
      "type": "object"
    },
    "NavPlace": {
      "description": "A space or zone a way goes through or to, and what a step calls it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "space",
            "zone"
          ],
          "title": "Kind",
          "type": "string"
        },
        "space_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a zone's space",
          "title": "Space Id"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "label": {
          "description": "what a step calls it: \"OFFICE 112\", \"Room 114\", \"the corridor\"",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "floor_id",
        "type",
        "label"
      ],
      "title": "NavPlace",
      "type": "object"
    }
  },
  "description": "navigation.json (format 0.8): the walking network of the package's building.",
  "properties": {
    "speed_m_s": {
      "title": "Speed M S",
      "type": "number"
    },
    "buildings": {
      "items": {
        "type": "string"
      },
      "title": "Buildings",
      "type": "array"
    },
    "floors": {
      "items": {
        "$ref": "#/$defs/NavFloor"
      },
      "title": "Floors",
      "type": "array"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/NavPlace"
      },
      "title": "Places",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NavNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/NavEdge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "speed_m_s",
    "buildings",
    "floors",
    "places",
    "nodes",
    "edges"
  ],
  "title": "Navigation",
  "type": "object"
}
{
  "$defs": {
    "OpeningFeature": {
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/PointGeometry",
          "description": "a point in the wall"
        },
        "properties": {
          "$ref": "#/$defs/OpeningProps"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "OpeningFeature",
      "type": "object"
    },
    "OpeningProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "opening",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/OpeningType"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "connects": {
          "description": "IDs of the spaces this opening joins",
          "items": {
            "type": "string"
          },
          "title": "Connects",
          "type": "array"
        },
        "exterior": {
          "description": "true when it leads outside the floor",
          "title": "Exterior",
          "type": "boolean"
        },
        "width_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clear width, jamb to jamb",
          "title": "Width M"
        },
        "span": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the opening across the wall, jamb to jamb",
          "title": "Span"
        },
        "swings": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a door's leaves as the plan draws them: each [hinge, its free edge when open]",
          "title": "Swings"
        },
        "sill_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how high above the floor it starts, from the drawing's schedule",
          "title": "Sill M"
        },
        "height_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "its height, from the drawing's schedule",
          "title": "Height M"
        },
        "hidden": {
          "default": false,
          "description": "real, but not shown unless asked for",
          "title": "Hidden",
          "type": "boolean"
        },
        "ignored": {
          "default": false,
          "description": "judged not worth anything by a person; leave it out",
          "title": "Ignored",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "floor_id",
        "connects",
        "exterior"
      ],
      "title": "OpeningProps",
      "type": "object"
    },
    "OpeningType": {
      "enum": [
        "door",
        "opening",
        "window"
      ],
      "title": "OpeningType",
      "type": "string"
    },
    "PointGeometry": {
      "properties": {
        "type": {
          "const": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PointGeometry",
      "type": "object"
    }
  },
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/OpeningFeature"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "FeatureCollection[OpeningFeature]",
  "type": "object"
}
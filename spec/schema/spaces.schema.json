{
  "$defs": {
    "MultiPolygonGeometry": {
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "MultiPolygonGeometry",
      "type": "object"
    },
    "PolygonGeometry": {
      "properties": {
        "type": {
          "const": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    },
    "SpaceFeature": {
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "geometry": {
          "description": "what its walls, doors and windows enclose",
          "discriminator": {
            "mapping": {
              "MultiPolygon": "#/$defs/MultiPolygonGeometry",
              "Polygon": "#/$defs/PolygonGeometry"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PolygonGeometry"
            },
            {
              "$ref": "#/$defs/MultiPolygonGeometry"
            }
          ],
          "title": "Geometry"
        },
        "properties": {
          "$ref": "#/$defs/SpaceProps"
        }
      },
      "required": [
        "id",
        "geometry",
        "properties"
      ],
      "title": "SpaceFeature",
      "type": "object"
    },
    "SpaceProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "space",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SpaceType"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "drawing_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the text written in it on the drawing, as written (its lines joined by a line break; never changed in review): a key to match on, beside the ID",
          "title": "Drawing Label"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "area_m2": {
          "title": "Area M2",
          "type": "number"
        },
        "display_point": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Display Point",
          "type": "array"
        },
        "zones": {
          "description": "IDs of the zones this space is divided into, with no wall between them (empty: one use)",
          "items": {
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        },
        "outdoor": {
          "default": false,
          "description": "open to the sky: a terrace or balcony with no windows of its own (a glazed veranda is not)",
          "title": "Outdoor",
          "type": "boolean"
        },
        "capacity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how many people it is meant to seat (format 0.7): set in review, else the workplaces of the items standing in it (a desk: one); null when neither says",
          "title": "Capacity"
        },
        "capacity_from": {
          "anyOf": [
            {
              "enum": [
                "review",
                "items"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what says so: review (a person set it) or items (its desks); null with no capacity",
          "title": "Capacity From"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "president",
                "c_level",
                "director",
                "manager",
                "section_head",
                "senior",
                "junior"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "who it is laid out for (format 0.7): the highest grade among the desks standing in it (president, c_level, director, manager, section_head, senior, junior); null without one",
          "title": "Grade"
        },
        "hidden": {
          "default": false,
          "description": "real, but not shown unless asked for (a shaft, a plant room)",
          "title": "Hidden",
          "type": "boolean"
        },
        "ignored": {
          "default": false,
          "description": "judged not worth anything by a person (a sliver, a pocket); leave it out",
          "title": "Ignored",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "floor_id",
        "area_m2",
        "display_point"
      ],
      "title": "SpaceProps",
      "type": "object"
    },
    "SpaceType": {
      "enum": [
        "office",
        "room",
        "meeting_room",
        "corridor",
        "lobby",
        "elevator",
        "stairs",
        "escalator",
        "ramp",
        "restroom",
        "kitchen",
        "storage",
        "utility",
        "shaft",
        "open_area",
        "unspecified",
        "bedroom",
        "living_room",
        "dining_room",
        "bathroom",
        "dressing_room",
        "laundry",
        "prayer_room",
        "parking",
        "balcony",
        "terrace",
        "open_to_below"
      ],
      "title": "SpaceType",
      "type": "string"
    }
  },
  "properties": {
    "type": {
      "const": "FeatureCollection",
      "default": "FeatureCollection",
      "title": "Type",
      "type": "string"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/SpaceFeature"
      },
      "title": "Features",
      "type": "array"
    }
  },
  "required": [
    "features"
  ],
  "title": "FeatureCollection[SpaceFeature]",
  "type": "object"
}
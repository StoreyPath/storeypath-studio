    "SpaceType": {
      "enum": [
        "office",
        "room",
        "meeting_room",
        "corridor",
        "lobby",
        "elevator",
        "stairs",
        "escalator",
        "ramp",
        "restroom",
        "kitchen",
        "storage",
        "utility",
        "shaft",
        "open_area",
        "unspecified",
        "bedroom",
        "living_room",
        "dining_room",
        "bathroom",
        "dressing_room",
        "laundry",
        "prayer_room",
        "parking",
        "balcony",
        "terrace",
        "open_to_below"
      ],
      "title": "SpaceType",
      "type": "string"
    },
    "ZoneProps": {
      "additionalProperties": true,
      "properties": {
        "kind": {
          "const": "zone",
          "title": "Kind",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SpaceType"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "drawing_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the text written in it on the drawing, as written (its lines joined by a line break; never changed in review): a key to match on, beside the ID",
          "title": "Drawing Label"
        },
        "space_id": {
          "description": "the space this zone is part of",
          "title": "Space Id",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "area_m2": {
          "title": "Area M2",
          "type": "number"
        },
        "display_point": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Display Point",
          "type": "array"
        },
        "hidden": {
          "default": false,
          "description": "real, but not shown unless asked for",
          "title": "Hidden",
          "type": "boolean"
        },
        "ignored": {
          "default": false,
          "description": "judged not worth anything by a person; leave it out",
          "title": "Ignored",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "space_id",
        "floor_id",
        "area_m2",
        "display_point"
      ],
      "title": "ZoneProps",
      "type": "object"
    }

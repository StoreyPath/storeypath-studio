{
  "name": "@storeypath/viewer-world",
  "version": "0.1.0",
  "description": "StoreyPath's 3D world (a building from a package, to look at from outside or walk through) as one ES module with three.js and JSZip inside: nothing else to install, nothing downloaded.",
  "type": "module",
  "main": "./dist/world.js",
  "types": "./dist/world.d.ts",
  "exports": {
    ".": {
      "types": "./dist/world.d.ts",
      "default": "./dist/world.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "default": "./dist/support.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "npm run build && npm run check && node test/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "keywords": [
    "indoor-mapping",
    "floor-plans",
    "threejs",
    "webgl",
    "3d"
  ],
  "license": "Apache-2.0",
  "author": "Khalefa <storeypath@alahmad.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoreyPath/storeypath.git",
    "directory": "viewer/world"
  }
}
